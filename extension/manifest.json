{
  "manifest_version": 3,
  "name": "Connect Char",
  "version": "0.1.1",
  "description": "Send prompts to supported AI web chats and relay completed answers to Hermes for review.",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://connect-char-relay.onrender.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://chat.deepseek.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Connect Char",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://gemini.google.com/*", "https://chat.deepseek.com/*", "https://claude.ai/*"],
      "js": ["src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
